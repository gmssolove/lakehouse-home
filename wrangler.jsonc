{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lakehouse-home",
  "account_id": "d47331fa71b913d9497c2ede130ab0fb",
  "main": "worker.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  /* 사이트 HTML·RSC는 한국 엣지에서. US 고정은 모든 클릭이 대서양을 왕복함. */
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lakehouse-home"
    }
  ],
  "routes": [
    {
      "pattern": "lakehouse.me.kr",
      "custom_domain": true
    },
    {
      "pattern": "www.lakehouse.me.kr",
      "custom_domain": true
    }
  ]
}
