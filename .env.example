# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lakehouse-images

# 업로드 후 클라이언트에 돌려줄 공개 URL prefix (끝 슬래시 없이)
# 예: https://lakehouse-r2-upload.gmssolove.workers.dev/file
# 또는 커스텀 CDN: https://img.lakehouse.me.kr
R2_PUBLIC_BASE_URL=

# 선택: 설정 시 업로드 API에 토큰 필요
R2_UPLOAD_TOKEN=

# YouTube Data API v3 (서버 전용 — Scrap 재생시간·업로드일)
YOUTUBE_API_KEY=

# ── OC AI 챗봇 ─────────────────────────────────────────────
# 기본: gemini (미설정 시에도 gemini). anthropic만 강제 시 OC_CHAT_PROVIDER=anthropic
OC_CHAT_PROVIDER=gemini

# Google Gemini — 권장 기본
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 최고 성능 (1차). 실패 시 FALLBACK → LITE 순으로 자동 폴백
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# 관련성 검증용 (짧게, thinking off)
GEMINI_VERIFY_MODEL=gemini-3.6-flash

# Anthropic Claude (API 별도 결제 필요 — 앱 구독과 무관)
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_VERIFY_MODEL=claude-haiku-4-5-20251001
# OC_CHAT_PROVIDER=anthropic
