# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lakehouse-images

# 업로드 후 클라이언트에 돌려줄 공개 URL prefix (끝 슬래시 없이)
# 예: https://lakehouse-r2-upload.gmssolove.workers.dev/file
# 또는 커스텀 CDN: https://img.lakehouse.me.kr
R2_PUBLIC_BASE_URL=

# 선택: 설정 시 업로드 API에 토큰 필요
R2_UPLOAD_TOKEN=

# YouTube Data API v3 (서버 전용 — Scrap 재생시간·업로드일)
YOUTUBE_API_KEY=

# ── OC AI 챗봇 ─────────────────────────────────────────────
# 제공자 강제: gemini | groq | anthropic (비우면 키 있는 무료 쪽 우선)
# OC_CHAT_PROVIDER=gemini

# Google Gemini (무료 티어) — 권장 기본
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (무료 티어, 카드 없이 키 발급 가능) — Gemini 쿼터 막힐 때
# https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (API 별도 결제 필요 — 앱 구독과 무관)
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# 캐릭터 준수·맥락: Sonnet 권장. 싸게 가려면 claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OC_CHAT_PROVIDER=anthropic
